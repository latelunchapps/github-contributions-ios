    "widget-guide-step-1-subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold an empty area on your screen until your apps jiggle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada una zona vacía de la pantalla hasta que las apps se muevan."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén presionada un área vacía de la pantalla hasta que las apps empiecen a moverse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面上に何もない場所を\nアプリが動くまで長押しします"
          }
        }
      }
    },
    "widget-guide-step-2-subtitle" : {
      "comment" : "Widget Setup guide, step 2. “Edit” and “Add Widget” are the Home Screen's own button and menu item, so use the system's translations. Don't name a corner: Edit is top-right on iPhone and top-left on iPad.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap 'Edit' at the top of the screen, then 'Add Widget'."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca 'Editar' en la parte superior de la pantalla y luego 'Añadir widget'."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Editar en la parte superior de la pantalla y luego Agregar widget."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面上部の「編集」をタップして\n「ウィジェットを追加」を選択します"
          }
        }
      }
    },
    "widget-guide-step-3-subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search for the 'Contributions' widget and tap the first result."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca 'Contribuciones' y toca el primer resultado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca “Contribuciones” y toca el primer resultado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Contributions」を検索し、\n1件目をタップします"
          }
        }
      }
    },
    "widget-guide-step-4-subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe left and right to choose the widget's size and shape, then tap 'Add Widget'."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el tamaño del widget y luego toca 'Añadir widget'."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza a la izquierda o a la derecha para elegir el tamaño del widget y luego toca Agregar widget."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィジェットのサイズを選択し、\n「ウィジェットを追加」をタップします"
          }
        }
      }
    },
    "widget-guide-step-5-subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the widget while it jiggles and you'll bring up the Widget settings menu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el widget mientras se mueve para abrir el menú de configuración."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
